[
  {
    "id": "chairsense_flow",
    "type": "tab",
    "label": "ChairSense MQTT",
    "disabled": false,
    "info": "MQTT sensor telemetry to dashboard gauge and chart"
  },
  {
    "id": "chairsense_tab",
    "type": "ui_tab",
    "name": "ChairSense",
    "icon": "dashboard",
    "order": 1,
    "disabled": false,
    "hidden": false
  },
  {
    "id": "chairsense_group",
    "type": "ui_group",
    "name": "Live Sensor Data",
    "tab": "chairsense_tab",
    "order": 1,
    "disp": true,
    "width": "12",
    "collapse": false,
    "className": ""
  },
  {
    "id": "hivemq_broker",
    "type": "mqtt-broker",
    "name": "HiveMQ Public Test Broker",
    "broker": "broker.hivemq.com",
    "port": "1883",
    "clientid": "",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "autoUnsubscribe": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "birthMsg": {},
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "closeMsg": {},
    "willTopic": "",
    "willQos": "0",
    "willPayload": "",
    "willMsg": {},
    "userProps": "",
    "sessionExpiry": ""
  },
  {
    "id": "chairsense_mqtt_in",
    "type": "mqtt in",
    "z": "chairsense_flow",
    "name": "ChairSense sensor",
    "topic": "chairsense/esp8266/sensor",
    "qos": "0",
    "datatype": "auto-detect",
    "broker": "hivemq_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 170,
    "y": 160,
    "wires": [["chairsense_json", "chairsense_raw_debug"]]
  },
  {
    "id": "chairsense_raw_debug",
    "type": "debug",
    "z": "chairsense_flow",
    "name": "Raw MQTT sensor message",
    "active": true,
    "tosidebar": true,
    "console": true,
    "tostatus": false,
    "complete": "true",
    "targetType": "full",
    "statusVal": "",
    "statusType": "auto",
    "x": 410,
    "y": 240,
    "wires": []
  },
  {
    "id": "chairsense_json",
    "type": "json",
    "z": "chairsense_flow",
    "name": "Parse sensor JSON",
    "property": "payload",
    "action": "obj",
    "pretty": false,
    "x": 390,
    "y": 160,
    "wires": [["chairsense_value"]]
  },
  {
    "id": "chairsense_value",
    "type": "change",
    "z": "chairsense_flow",
    "name": "Use sensorValue",
    "rules": [
      {
        "t": "set",
        "p": "payload",
        "pt": "msg",
        "to": "payload.sensorValue",
        "tot": "msg"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 610,
    "y": 160,
    "wires": [["chairsense_gauge", "chairsense_chart", "chairsense_debug"]]
  },
  {
    "id": "chairsense_gauge",
    "type": "ui_gauge",
    "z": "chairsense_flow",
    "name": "Sensor value gauge",
    "group": "chairsense_group",
    "order": 1,
    "width": "6",
    "height": "5",
    "gtype": "gage",
    "title": "Sensor Value",
    "label": "value",
    "format": "{{value}}",
    "min": 0,
    "max": 1023,
    "colors": ["#00b500", "#e6e600", "#ca3838"],
    "seg1": "",
    "seg2": "",
    "diff": false,
    "className": "",
    "x": 850,
    "y": 100,
    "wires": []
  },
  {
    "id": "chairsense_chart",
    "type": "ui_chart",
    "z": "chairsense_flow",
    "name": "Sensor value chart",
    "group": "chairsense_group",
    "order": 2,
    "width": "6",
    "height": "5",
    "label": "Sensor value",
    "chartType": "line",
    "legend": "false",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "Waiting for sensor data",
    "dot": false,
    "ymin": "0",
    "ymax": "1023",
    "removeOlder": 1,
    "removeOlderPoints": "",
    "removeOlderUnit": "3600",
    "cutout": 0,
    "useOneColor": false,
    "useUTC": false,
    "colors": ["#1f77b4", "#aec7e8", "#ff7f0e"],
    "outputs": 1,
    "useDifferentColor": false,
    "className": "",
    "x": 870,
    "y": 220,
    "wires": [[]]
  },
  {
    "id": "chairsense_debug",
    "type": "debug",
