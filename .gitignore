# Python environments and caches
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/

# Local configuration and secrets
backend/.env
**/.env
!.env.example
**/!.env.example

# Local databases and logs
backend/*.db
backend/logs/
**/*.log

# JavaScript dependencies and build output
frontend/node_modules/
frontend/dist/
**/node_modules/
**/dist/
**/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# PlatformIO firmware build output and local metadata
firmware/**/.pio/
firmware/**/.vscode/
firmware/**/broker/data/

# Editor and OS files
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db